{
  "name": "patchwake",
  "version": "0.2.0",
  "description": "A provider-neutral foundation for task-driven agent orchestrators",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "main": "./dist/patchwake/index.js",
  "types": "./dist/patchwake/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/patchwake/index.d.ts",
      "import": "./dist/patchwake/index.js"
    },
    "./*": {
      "types": "./dist/patchwake/*.d.ts",
      "import": "./dist/patchwake/*.js"
    }
  },
  "bin": {
    "patchwake-trello-github": "./dist/examples/trello_github/orchestrator.js"
  },
  "files": [
    "dist/patchwake",
    "dist/examples",
    "templates",
    "docs",
    "skills",
    "examples/trello_github/README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write patchwake examples tests package.json tsconfig*.json",
    "format:check": "prettier --check patchwake examples tests package.json tsconfig*.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "start": "node dist/examples/trello_github/orchestrator.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fs-ext": "^2.1.1"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^22.20.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
