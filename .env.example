# Trello board observation
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Comma-separated Trello list ids that define the agent's plate.
TRELLO_READY_LIST_IDS=

# GitHub activity observation and agent git access
GITHUB_TOKEN=
GITHUB_BOT_LOGIN=
GITHUB_API_URL=https://api.github.com

# Agent runtime: claude or codex
ORCHESTRA_AGENT_ENGINE=claude
CLAUDE_BIN=claude
CODEX_BIN=codex
ORCHESTRA_MODEL=
# Claude permission mode.
ORCHESTRA_PERMISSION_MODE=default
# Codex defaults to the documented unattended workspace boundary.
ORCHESTRA_CODEX_SANDBOX=workspace-write
# Task agents need outbound access to clone and talk to their configured venues.
ORCHESTRA_CODEX_NETWORK_ACCESS=1
# Only set to 1 inside an independently hardened environment.
ORCHESTRA_CODEX_DANGEROUS_BYPASS=0
# Explicitly opt environment variables into agent turns.
ORCHESTRA_AGENT_ENV=GITHUB_TOKEN,TRELLO_KEY,TRELLO_TOKEN

# Scheduler policy
ORCHESTRA_MAX_TURNS=3
ORCHESTRA_STALL_AFTER=900
ORCHESTRA_MAX_RESTARTS=5
ORCHESTRA_REQUIRE_DIRECTED=1
