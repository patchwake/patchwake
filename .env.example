# Trello board observation
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Comma-separated Trello list ids that define the agent's plate.
TRELLO_READY_LIST_IDS=

# GitHub activity observation and agent git access
GITHUB_TOKEN=
GITHUB_BOT_LOGIN=
GITHUB_API_URL=https://api.github.com

# Agent runtime: claude or codex
PATCHWAKE_AGENT_ENGINE=claude
CLAUDE_BIN=claude
CODEX_BIN=codex
PATCHWAKE_MODEL=
# Claude permission mode.
PATCHWAKE_PERMISSION_MODE=default
# Codex defaults to the documented unattended workspace boundary.
PATCHWAKE_CODEX_SANDBOX=workspace-write
# Task agents need outbound access to clone and talk to their configured venues.
PATCHWAKE_CODEX_NETWORK_ACCESS=1
# Only set to 1 inside an independently hardened environment.
PATCHWAKE_CODEX_DANGEROUS_BYPASS=0
# Explicitly opt environment variables into agent turns.
PATCHWAKE_AGENT_ENV=GITHUB_TOKEN,TRELLO_KEY,TRELLO_TOKEN

# Scheduler policy
PATCHWAKE_MAX_TURNS=3
PATCHWAKE_STALL_AFTER=900
PATCHWAKE_MAX_RESTARTS=5
PATCHWAKE_REQUIRE_DIRECTED=1
